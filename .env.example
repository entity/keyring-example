APP_NAME="Keyring Example"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Argon2id reads a whole password, where bcrypt stops at 72 bytes (OWASP ASVS
# 6.2.9). Accounts made while this app still hashed with bcrypt are rehashed
# as they sign in: uncomment HASH_VERIFY until they have been.
HASH_DRIVER=argon2id
# HASH_VERIFY=false

# Where sign ins come from, for the device list and the NewCountry and
# ImpossibleTravel risk signals. Unset, nothing is located. "cloudflare" reads
# Cloudflare's location headers: only safe when every request has to come
# through Cloudflare, since anyone else can send them. "demo" is for playing
# on your own machine: the login page gets a "Pretend to be in" picker. It's
# ignored unless APP_ENV is local or testing.
# KEYRING_LOCATOR=demo

# Have I Been Pwned. Unset, new passwords are checked in production only, as
# Keyring does by default. true checks them everywhere, and every password
# sign in too (the BreachedPassword risk signal); false turns it off. With
# REFUSE_UNCHECKED, a new password is refused while the service can't be
# reached, instead of let through.
# BREACHED_PASSWORD_CHECK=true
# BREACHED_PASSWORD_REFUSE_UNCHECKED=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=keyring_example
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="security@keyring.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
